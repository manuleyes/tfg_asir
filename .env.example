# ─── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_TYPE=sqlite          # sqlite | mysql
SQLITE_PATH=./vigilancia.db

# MySQL (solo si DATABASE_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=vigilancia_db

# ─── Seguridad ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=cambia_esto_en_produccion_2024
SESSION_SECRET_KEY=cambia_esto_en_produccion_2024
JWT_EXPIRATION_HOURS=24

# ─── Red ───────────────────────────────────────────────────────────────────────
PUBLIC_IP=127.0.0.1
PUBLIC_PORT=16000

# ─── Email / Alertas (opcional) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
